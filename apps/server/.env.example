# Development settings for `pnpm --filter @legko/server dev` (copy to apps/server/.env).
# Production values come from the Dockerfile / deploy/compose.yaml (see docs/DEPLOY.md).

# HTTP port (Vite proxies /api to 127.0.0.1:3000).
PORT=3000

# SQLite database + backups/. Default: /data in production, ./data otherwise.
DATA_DIR=./data

# Built web app to serve (index.html, assets/, sw.js). Leave unset in dev: Vite serves the UI.
# STATIC_DIR=../web/dist

# Canonical origin; also the default VAPID subject when it is https.
PUBLIC_ORIGIN=https://fit.triple-a.dev

NODE_ENV=development

# 1 behind Caddy: trust X-Forwarded-For / -Host / -Proto.
TRUST_PROXY=0

# Web Push. Keys are generated on first start and kept in the database unless both are set.
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# debug | info | warn | error | silent
LOG_LEVEL=info

# Development only (ignored when NODE_ENV=production): accounts created at start-up when missing; an existing
# account gets the password only when it has none. Not secrets — local test values. Production accounts come from
# invites; the owner's admin from `node cli.js create-admin admin` (a one-time setup link, docs/DEPLOY.md).
# DEV_USERNAME defaults to anna (role user), DEV_ADMIN_USERNAME to admin (role admin).
# DEV_USERNAME=anna
DEV_PASSWORD=legko-dev-password
# DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=legko-dev-admin-password

# AI calorie estimate (text or food photo → kcal, SPEC §3.7). Without a key the UI hides it.
# Never commit a real key: in production it lives only in /opt/training-app/.env (docs/DEPLOY.md).
# ANTHROPIC_API_KEY=
# Model override; the default supports the server-side refusal fallback the request relies on.
# FOOD_AI_MODEL=claude-opus-5-5
# Daily limits on the Kyiv day. Limits saved by an admin in «Користувачі» win over these.
# FOOD_DAILY_LIMIT is the GLOBAL ceiling — estimates for everybody together per day (default 150; 0 turns
# estimates off for everyone). Before the users release it meant «estimates per day» (default 60): adjust an old value.
# FOOD_DAILY_LIMIT=150
# FOOD_USER_DAILY_LIMIT is per account per day (default 40; 0–1000); an admin can set a per-account override.
# FOOD_USER_DAILY_LIMIT=40
